{% extends "base.html.j2" %}

{% block title %}Security Scan — {{ repo }}{% endblock %}

{% block content %}
{% if scanner_failures %}
<div style="border:1px solid #cf222e;background:#ffebe9;color:#82071e;padding:12px 16px;border-radius:6px;margin-bottom:16px;">
  <strong>Scan incomplete — not a clean result.</strong> These scanners did not run correctly, so their findings are missing from this report:
  <ul style="margin:8px 0 0 18px;padding:0;">
    {% for s in scanner_failures %}
    <li><strong>{{ s.scanner }}</strong>: {{ s.reason }}</li>
    {% endfor %}
  </ul>
</div>
{% endif %}
<div class="summary-row">
  <div class="stat">
    <div class="num">{{ total }}</div>
    <div class="label">Total findings</div>
  </div>
  {% for sev, count in counts.items() %}
  <div class="stat">
    <div class="num">{{ count }}</div>
    <div class="label">{{ sev | capitalize }}</div>
  </div>
  {% endfor %}
</div>

{% if not has_findings %}
<p class="empty">{% if scanner_failures %}No findings reported by the scanners that ran.{% else %}No findings — clean scan.{% endif %}</p>
{% else %}
<h2>Top findings (up to 20)</h2>
<table>
  <thead>
    <tr>
      <th>Severity</th>
      <th>Tool</th>
      <th>Rule</th>
      <th>Location</th>
      <th>Title</th>
    </tr>
  </thead>
  <tbody>
    {% for f in findings %}
    <tr>
      <td><span class="badge badge-{{ f.severity.value }}">{{ f.severity.value }}</span></td>
      <td>{{ f.tool }}</td>
      <td>
        {% if f.url %}<a href="{{ f.url }}">{{ f.rule_id }}</a>{% else %}{{ f.rule_id }}{% endif %}
      </td>
      <td><code>{{ f.location }}</code></td>
      <td>{{ f.title }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
{% if total > 20 %}
<p style="font-size:13px;color:#57606a;margin-top:8px;">… and {{ total - 20 }} more. See the full run for details.</p>
{% endif %}
{% endif %}
{% endblock %}
