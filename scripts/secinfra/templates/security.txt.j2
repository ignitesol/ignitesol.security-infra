{% extends "base.txt.j2" %}
{% block title %}Security Scan — {{ repo }}{% endblock %}
{% block content %}
{% if scanner_failures %}
!! SCAN INCOMPLETE — NOT A CLEAN RESULT !!
These scanners did not run correctly; their findings are missing from this report:
{% for s in scanner_failures %}
  - {{ s.scanner }}: {{ s.reason }}
{% endfor %}

{% endif %}
Total findings: {{ total }}
{% for sev, count in counts.items() %}  {{ sev | upper }}: {{ count }}
{% endfor %}

{% if not has_findings %}
{% if scanner_failures %}No findings reported by the scanners that ran.{% else %}No findings — clean scan.{% endif %}
{% else %}
Top findings (up to 20):
{% for f in findings %}
[{{ f.severity.value | upper }}] {{ f.tool }} / {{ f.rule_id }}
  Location : {{ f.location }}
  Title    : {{ f.title }}
  Message  : {{ f.message[:120] }}
{% endfor %}
{% if total > 20 %}
... and {{ total - 20 }} more. See the full run.
{% endif %}
{% endif %}
{% endblock %}
